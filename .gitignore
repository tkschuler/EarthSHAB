evaluation/launches.archive*.json
evaluation/gfs_repro/

# Generated trajectory / prediction / evaluation maps. Already-committed example
# outputs (the bundled 2022-08-22 SHAB14V set) remain tracked; only new generated
# files are ignored.
src/EarthSHAB/trajectories/*.html
!src/EarthSHAB/trajectories/SHAB14V-APRS_GFS_0p25deg_3hr_2022_8_22.html
!src/EarthSHAB/trajectories/SHAB14V-APRS_ERA5_0p25deg_1hr_2022_8_22.html
!src/EarthSHAB/trajectories/PREDICTION_GFS_1deg_3hr_2026_6_10.html"

# Single-flight evaluation outputs written to the evaluation/ root
evaluation/*.html
evaluation/*.csv
evaluation/*.png

# Local one-off ERA5/BASS helper scripts and run logs
evaluation/*_bass.py
evaluation/download_archive_gfs.py
logs/

